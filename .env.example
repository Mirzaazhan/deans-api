# =============================================================================
# DEANS API - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and customize for your environment.
# NEVER commit the actual .env file to version control.
#
# For Docker deployments, these can be set in docker-compose.yaml or passed
# via the 'environment' directive.
# =============================================================================

# -----------------------------------------------------------------------------
# DJANGO CORE SETTINGS
# -----------------------------------------------------------------------------

# SECURITY CRITICAL: Generate a unique secret key for production!
# Generate using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production

# Set to '1' for production deployment
# When set, enables security headers and disables debug features
PRODUCTION=0

# Comma-separated list of allowed hostnames
# Example: deans.csming.com,api.deans.csming.com
# Use '*' only for development (security risk in production)
DJANGO_ALLOWED_HOSTS=*

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

# Set to '1' when running inside Docker to use PostgreSQL
IN_DOCKER=0

# PostgreSQL connection settings (used when IN_DOCKER=1)
POSTGRES_DB=deans_db
POSTGRES_USER=deans_user
POSTGRES_PASSWORD=deans_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database connection pooling (seconds, 0 = no persistent connections)
POSTGRES_CONN_MAX_AGE=60

# Connection timeout in seconds
POSTGRES_CONNECT_TIMEOUT=10

# -----------------------------------------------------------------------------
# REDIS / CHANNEL LAYERS
# -----------------------------------------------------------------------------

# Redis host for Django Channels (WebSocket support)
# Default: 'redis' for Docker, 'localhost' for local development
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins for CORS
# Include the protocol (http/https) and port if non-standard
# Example: https://deans.csming.com,https://admin.deans.csming.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# REST API CONFIGURATION
# -----------------------------------------------------------------------------

# Default page size for paginated API responses
API_PAGE_SIZE=20

# Rate limiting for anonymous users (requests per period)
# Format: number/period where period is: second, minute, hour, day
API_THROTTLE_ANON=100/hour

# Rate limiting for authenticated users
API_THROTTLE_USER=1000/hour

# -----------------------------------------------------------------------------
# SECURITY HEADERS (Production Only)
# -----------------------------------------------------------------------------

# Redirect HTTP to HTTPS (set to 'false' if behind a proxy that handles SSL)
SECURE_SSL_REDIRECT=true

# HSTS (HTTP Strict Transport Security) max-age in seconds
# Default: 31536000 (1 year)
SECURE_HSTS_SECONDS=31536000

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Development default: DEBUG, Production default: INFO
DJANGO_LOG_LEVEL=INFO

# Directory for log files (will be created if doesn't exist)
# Default: logs/ in the project directory
DJANGO_LOG_DIR=/var/log/deans-api

# -----------------------------------------------------------------------------
# NOTIFICATION SERVICE CONFIGURATION (Managed by Aiman's task)
# -----------------------------------------------------------------------------
# These settings control communication with the notification microservice

# NOTIFICATION_SOCIAL_MESSAGES_URL=http://notification:8000/socialmessages/
# NOTIFICATION_DISPATCH_NOTICES_URL=http://notification:8000/dispatchnotices/
# NOTIFICATION_REQUEST_TIMEOUT=10
# NOTIFICATION_MAX_RETRIES=3
# NOTIFICATION_RETRY_DELAY=1

# Crisis Management URLs
# DEANS_URL=https://deans.csming.com/
# SHELTER_URL=https://deans.csming.com/
